# Copy to /etc/desaymem-light/desaymem-light.env and chmod 600.
DESAYMEM_ENV=cloud-test
DESAYMEM_CONFIG_PATH=/opt/desaymem-light/config/cloud-test.yaml
DESAYMEM_HTTP_HOST=0.0.0.0
DESAYMEM_HTTP_PORT=8000
DESAYMEM_LOG_LEVEL=INFO

QWEN_BASE_URL=http://qwen-service:8000/v1
QWEN_MODEL=Qwen3-32B
QWEN_API_KEY=EMPTY
QWEN_TIMEOUT_SECONDS=60
QWEN_TOKENIZER_PATH=/opt/models/qwen3-tokenizer

BGE_BASE_URL=http://bge-service:8000/v1
BGE_MODEL=BGE-M3
BGE_API_KEY=EMPTY
EMBEDDING_DIMS=1024
BGE_TIMEOUT_SECONDS=30

POSTGRES_DSN=postgresql://USER:PASSWORD@HOST:5432/DATABASE
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=10
SQLITE_PATH=/var/lib/desaymem-light/sqlite/history.db
SQLITE_BUSY_TIMEOUT_MS=5000
JSON_MIRROR_ROOT=/var/lib/desaymem-light/json
JSON_MIRROR_MIN_FREE_BYTES=1073741824

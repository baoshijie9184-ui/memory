[Unit]
Description=DesayMem Light API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=desaymem
Group=desaymem
WorkingDirectory=/opt/desaymem-light
EnvironmentFile=/etc/desaymem-light/desaymem-light.env
ExecStart=/opt/desaymem-light/.venv/bin/desaymem-api
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

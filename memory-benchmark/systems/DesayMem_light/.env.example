# Application
DESAYMEM_ENV=cloud-test
DESAYMEM_CONFIG_PATH=/app/config/cloud-test.yaml
DESAYMEM_HTTP_HOST=0.0.0.0
DESAYMEM_HTTP_PORT=8000
DESAYMEM_LOG_LEVEL=INFO

# Existing Qwen3-32B service
QWEN_BASE_URL=
QWEN_MODEL=
QWEN_API_KEY=
QWEN_TIMEOUT_SECONDS=60
QWEN_TOKENIZER_PATH=

# Existing BGE-M3 service
BGE_BASE_URL=
BGE_MODEL=BGE-M3
EMBEDDING_DIMS=1024
BGE_TIMEOUT_SECONDS=30

# Storage
POSTGRES_DSN=
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=10
SQLITE_PATH=/data/sqlite/desaymem_light_history.db
SQLITE_BUSY_TIMEOUT_MS=5000
JSON_MIRROR_ROOT=/data/json-mirror/desaymem_light
JSON_MIRROR_MIN_FREE_BYTES=1073741824

# Secrets must be injected by the deployment platform.

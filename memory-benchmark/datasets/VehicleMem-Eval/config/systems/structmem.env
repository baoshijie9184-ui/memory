# structmem / structmem-nosummary（LightMem 家族）专用配置
# ============================================================
# 主脚本 run_full.sh 不认识任何具体算法——本系统的能力全部在这里声明
# ============================================================

# ---- LLM（建库管线 build_lightmem_lib.py 读；评测端走 models.yaml --model-config）----
LIGHTMEM_API_BASE=http://127.0.0.1:20140/v1
LIGHTMEM_API_KEY=boluoboluomi
LIGHTMEM_LLM_MODEL=memory-llm

# ---- python 环境 ----
# 建库进程（需要 lightmem/qdrant_client/tiktoken + 本地 GPU 模型；eval 环境缺这些包）
PY_BUILD=/data/pengshuang/memory-benchmark/envs/lightmem/bin/python

# ---- 建库声明（主脚本据此决定"要不要预建库"）----
# 建库脚本；不设此变量的系统（none/mem0）评测时自写库或无记忆，跳过建库阶段
BUILD_SCRIPT=/data/pengshuang/memory-benchmark/systems/LightMem/experiments/locomo/build_lightmem_lib.py
# 建库参数模板；{DS} 由主脚本替换为当前数据集名
#   --skip-existing 是断点续跑关键：已建 collection 跳过，库删了就全量重建
BUILD_ARGS="--dataset {DS} --turn-limit 0 --extraction-mode event --skip-existing"

# 库根目录按数据集不同——用 case 生成（bash 数组不便存 env，此处用 eval 逻辑）
# locomo 全量库在 data/lightmem/qdrant_post_update/（conv-26/30/41…，已建好；
#   若目录被删，build 脚本 --dataset locomo 不支持，需用 add_locomo.py 重建，见 LightMem-LoCoMo全量测试指南.md）
# 其他数据集库在 qdrant_new_datasets/qdrant_post_update/ 下
DS_LIB_ROOT()
{
  case "$1" in
    locomo) echo "/data/pengshuang/memory-benchmark/data/lightmem/qdrant_post_update" ;;
    *)      echo "/data/pengshuang/memory-benchmark/data/lightmem/qdrant_new_datasets/qdrant_post_update" ;;
  esac
}
# 主脚本 source 本文件后调 DS_LIB_ROOT/DS_COLLECTION_PREFIX $DATASET 取值

# collection 命名前缀（bridge 的 uid→collection 映射用）：
#   locomo 用 conv-26/30/41… 命名不走前缀（bridge 默认行为，返回空）
DS_COLLECTION_PREFIX()
{
  case "$1" in
    locomo) echo "" ;;
    carmem)          echo "carmem_" ;;
    vehiclemembench) echo "vehiclemembench_" ;;
    longmemeval)     echo "longmemeval_" ;;
    desaymem)        echo "desaymem_" ;;
    *)               echo "{DS}_" ;;
  esac
}
